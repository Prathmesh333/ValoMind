# DESIGN-ONLY sample environment; Codex will wire these during M0.
APP_ENV=development
DEMO_SYNTHETIC=true
ENABLE_EXTERNAL_RIOT=false
ENABLE_GRID=false
ENABLE_SIMULATION=false
DATABASE_URL=postgresql+psycopg://valomind:valomind_local_only@localhost:5432/valomind
REDIS_URL=redis://localhost:6379/0
STORAGE_PROVIDER=local
STORAGE_BUCKET=valomind-private
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
MAX_UPLOAD_BYTES=1073741824
LLM_PROVIDER=none
# DO NOT use default or blank JWT signing key for a deployed environment.
JWT_SIGNING_KEY=
LLM_API_KEY=
